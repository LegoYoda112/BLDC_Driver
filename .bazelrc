build:stm32g4 --platforms=//platforms:stm32g4
build:stm32g4 --incompatible_enable_cc_toolchain_resolution

build:v0_0 --copt=-DHW_REV=1
build:v0_1 --copt=-DHW_REV=2
build:v0_2 --copt=-DHW_REV=3

build:debug --config=stm32g4
build:debug --compilation_mode=dbg
build:debug --copt=-Og
build:debug --copt=-g3
build:debug --copt=-ggdb